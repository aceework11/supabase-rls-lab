# Copy to .env. These are the FIXED local development keys that ship with the Supabase
# CLI — they are identical on every machine on earth and are not secrets. No key in this
# repo is real, and none should ever be.
#
# Regenerate at any time with:  npx supabase status -o env

SUPABASE_URL=http://127.0.0.1:55321
ANON_KEY=<from `npx supabase status -o env`>
SERVICE_ROLE_KEY=<from `npx supabase status -o env`>
