{
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2",
    "postgres": "npm:postgres@3",
    "@std/assert": "jsr:@std/assert@1",
    "@std/testing/bdd": "jsr:@std/testing@1/bdd"
  },
  "tasks": {
    "db:start": "npx --yes supabase@2.117.0 start",
    "db:stop": "npx --yes supabase@2.117.0 stop",
    "db:reset": "npx --yes supabase@2.117.0 db reset",
    "seed": "deno run --allow-net --allow-env --env-file=.env scripts/seed.ts",
    "test": "deno test --allow-net --allow-env --allow-read=. --env-file=.env --no-check tests/",
    "verify": "deno task db:reset && deno task seed && deno task test"
  },
  "fmt": {
    "lineWidth": 90
  }
}
